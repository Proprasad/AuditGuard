{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Investigations Completed by Mode & Disposition",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (mode, disposition) (auditguard_investigations_total)",
          "legendFormat": "{{mode}} · {{disposition}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Investigation Latency (P50 & P95 Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(auditguard_investigation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 ({{mode}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(auditguard_investigation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 ({{mode}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Guarded FastMCP Tool Calls by Mode",
      "type": "stat",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (mode) (auditguard_tool_calls_total)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Regulatory Citations Verified (Passed vs Failed)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (auditguard_citations_verified_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    }
  ],
