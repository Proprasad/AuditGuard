# ============================================================
# AuditGuard Environment Template (safe to commit - contains NO real secrets)
#   1. cp .env.example .env
#   2. python scripts/init_env.py      # generates strong random secrets for every CHANGE_ME value
#   3. paste your OpenRouter key into OPENROUTER_API_KEY (never commit .env)
# Budgets, policy bounds, model slugs and temperatures live in config/models.yaml
# (OPENAI_MODEL / OPENAI_STRONG_MODEL / MAX_* below are optional overrides validated at startup).
# ============================================================

# --- Environment (development | test | staging | production) ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Persistence ---
SQLITE_DB_PATH=data/auditguard.db
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auditguard
POSTGRES_USER=auditguard

# --- MCP transport (`inprocess` for single-command local dev, `http` for the container fleet) ---
MCP_TRANSPORT=inprocess
MCP_HOST=localhost
MCP_COMPLIANCE_KB_PORT=8010
MCP_GRAPH_ENGINE_PORT=8011
MCP_BANK_RECORDS_PORT=8012
MCP_CASE_ACTIONS_PORT=8013

# --- LLM / OpenRouter (toggle with LLM_ENABLED) ---
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional overrides of config/models.yaml (must be in `allowed_models`):
# OPENAI_MODEL=openai/gpt-5-mini
# OPENAI_STRONG_MODEL=openai/gpt-5-mini
# MAX_TOOL_CALLS=15
# MAX_TOOL_BUDGET_USD=0.15
# MAX_REPLANS=3
# MAX_CRITIQUE_RETRIES=2

# --- Security (REQUIRED outside development/test; use scripts/init_env.py) ---
AUTH_REQUIRED=true

# --- Vector store / API / UI ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=compliance_kb
API_HOST=127.0.0.1
API_PORT=8000
CHAINLIT_HOST=127.0.0.1
CHAINLIT_PORT=8001

# --- Observability stack (docker compose) ---
LANGFUSE_HOST=http://localhost:3000
LOKI_URL=http://localhost:3100
API_SECRET_KEY=voaLI2l-MAkLc0cW49xWT0LOyFLRjm60a0kYO5_F62uMhQnl9EsrKOptbNVZsttB
