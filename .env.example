# ============================================================
# AuditGuard Environment Configuration Template
# Copy this file to .env and paste your personal API key into .env.
# NEVER commit your real API key to GitHub (.env is gitignored).
# ============================================================

# --- Environment & Logging ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Persistence (Local SQLite Default; PostgreSQL in Docker) ---
SQLITE_DB_PATH=data/auditguard.db
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auditguard
POSTGRES_USER=auditguard
POSTGRES_PASSWORD=auditguard_secret
DATABASE_URL=postgresql+asyncpg://auditguard:auditguard_secret@localhost:5432/auditguard

# --- MCP Transport (`inprocess` for single-command local dev, `http` for Docker fleet) ---
MCP_TRANSPORT=inprocess
MCP_COMPLIANCE_KB_PORT=8010
MCP_GRAPH_ENGINE_PORT=8011
MCP_BANK_RECORDS_PORT=8012
MCP_CASE_ACTIONS_PORT=8013

# --- LLM / OpenRouter Configuration (Toggle with LLM_ENABLED=true / false) ---
# Set LLM_ENABLED=true to call live OpenRouter models, or LLM_ENABLED=false for $0 offline mode.
LLM_ENABLED=false
OPENROUTER_API_KEY=sk-or-v1-placeholder
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5-mini
OPENAI_STRONG_MODEL=openai/gpt-5-mini

# --- Vector Store (Qdrant — Optional locally; Hybrid BM25+Vector RRF runs locally) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=compliance_kb

# --- FastAPI Gateway & Embedded Analyst Console ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=auditguard-dev-jwt-secret-change-in-prod
AUTH_REQUIRED=false

# --- Optional Chainlit UI ---
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8001

# --- Security & Governance ---
HMAC_SECRET=auditguard-dev-hmac-secret-change-in-prod
RBAC_ADMIN_USERS=admin@bank.com
MAX_TOOL_BUDGET_USD=0.15

# --- Bounded Graph Engine Defaults ---
GRAPH_MAX_HOPS=3
GRAPH_TIME_WINDOW_DAYS=7
GRAPH_AMOUNT_TOLERANCE=0.10

# --- Observability ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
PROMETHEUS_PORT=9090
